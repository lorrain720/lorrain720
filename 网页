  footer ul { list-style: none; display: grid; gap: 10px; }

  footer ul a { transition: color .2s; }
  footer ul a:hover { color: #fff; }

  .footer-bottom {
    border-top: 1px solid #1e293b;
    padding-top: 26px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: #64748b;
    font-size: .86rem;
